[ req ]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = req_distinguished_name
req_extensions     = req_ext

[ req_distinguished_name ]
C  = SO
O  = Premier Bank
CN = PMRBSOMM

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = localhost
DNS.2 = adapter.premierbank.so
IP.1  = 127.0.0.1
URI.1 = urn:iso:20022:bic:PMRBSOMM
