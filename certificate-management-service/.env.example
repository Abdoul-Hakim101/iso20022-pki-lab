# ===================================================================
# Central Bank PKI - Production Environment Variables Template
# Copy this file to .env and configure real production secrets.
# ===================================================================

# Active Spring Profile (dev / prod)
SPRING_PROFILES_ACTIVE=prod

# Database Connection Settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=certificate_db
DB_USERNAME=pki_prod_user
DB_PASSWORD=ChangeThisToASecureProdPassword123!

# Hibernate & API Documentation
DB_DDL_STRATEGY=validate
DB_SHOW_SQL=false
SPRING_DOC_API_DOCS_ENABLED=false
SPRING_DOC_SWAGGER_UI_ENABLED=false

# Central Bank PKI CA Directory Configuration
PKI_CA_DIR=/etc/pki/ca
PKI_CA_KEY_FILE=private.pem
PKI_CA_CERT_FILE=chain.pem
PKI_CA_ISSUER_DN=CN=Central Bank of Somalia Root CA, O=Central Bank of Somalia, C=SO
PKI_CA_VALIDITY_YEARS=10

# Modulith Events Retry Configuration
EVENTS_RETRY_MAX_ATTEMPTS=5
EVENTS_RETRY_DELAY=PT60S

# CORS configuration
CORS_ALLOWED_ORIGINS=https://your-production-domain.com